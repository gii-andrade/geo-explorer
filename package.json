{
  "name": "geo-explorer",
  "version": "1.0.0",
  "description": "Aplicação de exploração de trilhas de aprendizagem — projeto DIO",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "geo-explorer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
